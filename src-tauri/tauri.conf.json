{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ace-60-switcher",
  "version": "0.1.0",
  "identifier": "com.tahil.ace-60-switcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ace 60 Switcher",
        "width": 400,
        "height": 500,
        "visible": false,
        "resizable": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
